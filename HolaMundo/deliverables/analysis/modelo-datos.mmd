erDiagram
    Usuario ||--o{ Sesion : "tiene"
    Usuario {
        int id PK
        string nombre
        string email
        string contrasena
        datetime fecha_registro
    }
    Sesion {
        int id PK
        int usuario_id FK
        datetime fecha_inicio
        datetime fecha_fin
        string ip
    }
    Pagina ||--o{ Visita : "tiene"
    Pagina {
        int id PK
        string titulo
        string url
        string contenido
        datetime fecha_creacion
    }
    Visita {
        int id PK
        int pagina_id FK
        datetime fecha_visita
        string ip
        string navegador
    }