import { createCanvas } from 'canvas';
import fs from 'fs';

// Crear un lienzo de 200x200 píxeles
const canvas = createCanvas(200, 200);
const ctx = canvas.getContext('2d');

// Dibujar un fondo blanco
ctx.fillStyle = '#FFFFFF';
ctx.fillRect(0, 0, canvas.width, canvas.height);

// Dibujar un círculo rojo
ctx.fillStyle = '#FF0000';
ctx.beginPath();
ctx.arc(100, 100, 80, 0, Math.PI * 2);
ctx.fill();

// Dibujar el texto "Hola Mundo" en el centro del círculo
ctx.fillStyle = '#FFFFFF';
ctx.font = 'bold 20px Arial';
ctx.textAlign = 'center';
ctx.textBaseline = 'middle';
ctx.fillText('Hola Mundo', 100, 100);

// Guardar el lienzo como un archivo PNG
const out = fs.createWriteStream('src/images/logo.png');
const stream = canvas.createPNGStream();
stream.pipe(out);
out.on('finish', () => console.log('Logo generado con éxito'));